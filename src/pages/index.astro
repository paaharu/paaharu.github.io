---
import Layout from '../layouts/Layout.astro';
import projects from '../data/projects.json';
import links from '../data/links.json';

const siteStart = new Date('2026-04-15');
const today = new Date();
const daysSince = Math.floor((today.getTime() - siteStart.getTime()) / (1000 * 60 * 60 * 24));
---

<Layout title="paaru">
  <div class="max-w-5xl mx-auto px-6 py-12 grid gap-16">

    <!-- Hero -->
    <section class="flex items-center justify-between gap-8 pb-32">
      <div class="grid gap-8">
        <div class="grid gap-6">
          <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-zinc-900 leading-tight">
            Paaru's<br class="md:hidden" /><span class="whitespace-nowrap"> Home Page</span>
          </h1>
          <div class="grid gap-2">
            <p id="hero-desc" class="text-lg text-zinc-500 max-w-md leading-relaxed">
              多趣味人間のいろいろポートフォリオ
            </p>
            <p class="text-sm text-zinc-400">
              更新できるように頑張っていきます
            </p>
          </div>
        </div>
      </div>
      <img
        src="/mitokon.png"
        alt="アイコン"
        class="w-56 h-56 rounded-full object-cover shrink-0 border border-zinc-200"
      />
    </section>

    <hr class="border-zinc-200" />

    <!-- Works -->
    <section id="works" class="grid gap-4 scroll-mt-24">
      <h2 class="text-sm font-bold text-[#5383c3] tracking-widest">Works</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <a href={project.link} target="_blank" rel="noopener noreferrer"
             class="bg-slate-50 border border-zinc-200 rounded-xl p-6 hover:border-zinc-400 hover:shadow-lg hover:-translate-y-1 transition-all flex flex-col group min-h-[320px] max-w-sm">
            <div class="flex-1 grid gap-4">
              <h3 class="font-semibold text-zinc-900">{project.title}</h3>
              
              {project.title.includes("ラグビー部") && (
                <div class="aspect-video w-full overflow-hidden rounded-lg border border-zinc-200 shadow-sm">
                  <img src="/rugby-club.jpg" alt="ラグビー部" class="w-full h-full object-cover" />
                </div>
              )}

              <p class="text-sm text-zinc-500 leading-relaxed line-clamp-3">{project.description}</p>
            </div>
            
            <div class="grid gap-4 mt-auto pt-4">
              <div class="flex flex-wrap gap-2">
                {project.tech.map((t) => (
                  <span class="text-[10px] bg-zinc-200 text-zinc-600 px-2 py-1 rounded-md">{t}</span>
                ))}
              </div>
              <span class="text-sm text-zinc-400 group-hover:text-zinc-700 transition-colors self-end">
                詳細を見る ↗
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <hr class="border-zinc-200" />

    <!-- Articles Preview -->
    <section id="articles" class="grid gap-4 scroll-mt-24">
      <h2 class="text-sm font-bold text-[#5383c3] tracking-widest">Articles</h2>
      <p class="text-sm text-zinc-400">準備中...</p>
    </section>

    <hr class="border-zinc-200" />

    <!-- Links -->
    <section id="links" class="grid gap-4 scroll-mt-24">
      <h2 class="text-sm font-bold text-[#5383c3] tracking-widest">Links</h2>
      <div class="grid gap-6 grid-cols-2 sm:grid-cols-3">
        {links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer"
             class="group bg-slate-50 border border-zinc-200 rounded-xl px-5 py-4 hover:border-zinc-400 hover:shadow-lg hover:-translate-y-1 transition-all flex items-center justify-between">
            <p class="font-semibold text-zinc-900">{link.name}</p>
            <span class="text-sm text-zinc-400 group-hover:text-zinc-700 transition-colors">
              ↗
            </span>
          </a>
        ))}
      </div>
    </section>

    <hr class="border-zinc-200" />

    <!-- Site age -->
    <section class="bg-zinc-50 border border-zinc-200 rounded-2xl p-8 text-center">
      <p class="text-xl text-zinc-600 font-medium flex items-center justify-center gap-1">
        このサイトができてから<span id="loading-dots" class="inline-block w-6 text-left font-bold"></span>
        <span class="text-3xl font-bold text-zinc-900 ml-2">{daysSince}日</span>
      </p>
    </section>

    <script>
      const dots = document.getElementById('loading-dots');
      let count = 0;
      if (dots) {
        setInterval(() => {
          count = (count + 1) % 4;
          dots.textContent = '.'.repeat(count);
        }, 500);
      }
    </script>

  </div>
</Layout>
